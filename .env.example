APP_NAME="AURA CARD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# cPanel / MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auracard_db
DB_USERNAME=root
DB_PASSWORD=

# Session / Cache / Queue
# Local / VPS option (High-throughput Redis):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
#
# cPanel / Shared Hosting fallback (Database-driven, Zero Redis requirement):
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=auracard_cache_

QUEUE_CONNECTION=database

# Redis Configuration (Used when CACHE/QUEUE/SESSION are set to redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Social Authentication (Google, Facebook, Instagram)
SOCIAL_LOGIN_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SOCIAL_LOGIN_FACEBOOK_ENABLED=true
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Instagram Authentication (Disabled by default: requires verified Meta Business/Creator account setup)
SOCIAL_LOGIN_INSTAGRAM_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

# AI Marketing Asset Studio Driver
# Supported: 'none' (default local vector engine), 'openai', 'stability'
IMAGE_GENERATION_DRIVER=none
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=

# Filesystem Disks
FILESYSTEM_DISK=public
FILESYSTEM_PRIVATE_DISK=local

# Email / SMTP Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.auracard.ma
MAIL_PORT=587
MAIL_USERNAME=support@auracard.ma
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@auracard.ma"
MAIL_FROM_NAME="${APP_NAME}"

# Business & Support Configuration (Defaults)
AURACARD_SUPPORT_WHATSAPP="+212600000000"
AURACARD_SUPPORT_EMAIL="support@auracard.ma"
AURACARD_CARD_PRICE_MAD=150.00
AURACARD_INCLUDED_MODIFICATION_CREDITS=2

# Security & Upload Limits (KB)
AURACARD_MAX_AVATAR_SIZE_KB=2048
AURACARD_MAX_COVER_SIZE_KB=4096
AURACARD_MAX_PROOF_SIZE_KB=8192

# Vite
VITE_APP_NAME="${APP_NAME}"
